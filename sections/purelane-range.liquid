<style>
#purelane-range-{{ section.id }} {
  /* VERSION 2 — LIGHT MODE (from prototype) */
  --ink:#f4f0fb;
  --deep:#e2daf3;
  --brand:#4b3a8f;
  --brand-lt:#6b55b8;
  --paper:#241a3d;
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;
  --accent-2:#c9761d;
  --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --r-sm:16px;
  --maxw:1180px;
  --ease:cubic-bezier(.2,.7,.2,1);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  color:var(--paper);
  line-height:1.62;
  -webkit-font-smoothing:antialiased;
  padding:0 0 clamp(30px,4vw,60px);

  /* Product SVGs */
  --p-tap:url("data:image/svg+xml;base64,");
  --p-kitchen:url("data:image/svg+xml;base64,");
  --p-metal:url("data:image/svg+xml;base64,");
  --p-wm:url("data:image/svg+xml;base64,");
  --p-dish:url("data:image/svg+xml;base64,");
  --p-floor:url("data:image/svg+xml;base64,");
  --p-toilet:url("data:image/svg+xml;base64,");
  --p-laundry:url("data:image/svg+xml;base64,");
  --p-handwash:url("data:image/svg+xml;base64,");
  --p-eraser:url("data:image/svg+xml;base64,");
}

#purelane-range-{{ section.id }} a { text-decoration: none; color: inherit; }
#purelane-range-{{ section.id }} p, #purelane-range-{{ section.id }} h2 { margin: 0; }
#purelane-range-{{ section.id }} .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 18px; }

/* Glass Panel */
#purelane-range-{{ section.id }} .glass {
  background: var(--g-bg);
  backdrop-filter: blur(24px) saturate(150%);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  border: 1px solid var(--g-line);
  border-radius: var(--r);
  box-shadow: var(--g-shadow), var(--g-inset);
  position: relative;
  overflow: hidden;
  padding: clamp(20px, 2.6vw, 30px);
}
#purelane-range-{{ section.id }} .glass::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(115deg, rgba(255, 255, 255, .55), transparent 32%, transparent 74%, rgba(201, 118, 29, .06));
}

/* Header */
#purelane-range-{{ section.id }} .range-head {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-end;
  gap: 14px;
  justify-content: space-between;
  margin-bottom: 8px;
  position: relative;
  z-index: 2;
}
#purelane-range-{{ section.id }} .kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--paper-3);
  display: block;
}
#purelane-range-{{ section.id }} .d2 {
  font-family: 'Outfit', system-ui, sans-serif;
  text-transform: uppercase;
  letter-spacing: -.018em;
  font-weight: 800;
  line-height: .94;
  color: var(--surface);
  font-size: clamp(26px, 3.8vw, 46px);
  max-width: 20ch;
}
#purelane-range-{{ section.id }} .body-s {
  font-size: 13.5px;
  color: var(--paper-2);
  line-height: 1.6;
  max-width: 36ch;
  margin-bottom: 4px;
}

/* Range Strip */
#purelane-range-{{ section.id }} .stripwrap {
  margin: 14px 0 0;
  overflow-x: auto;
  overflow-y: hidden;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
  position: relative;
  z-index: 2;
}
#purelane-range-{{ section.id }} .stripwrap::-webkit-scrollbar {
  display: none;
}
#purelane-range-{{ section.id }} .rangerow {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 8px;
  min-height: 150px;
  padding: 4px 0 10px;
}
#purelane-range-{{ section.id }} .rangerow .pimg {
  height: 132px;
  filter: drop-shadow(0 9px 14px rgba(0, 74, 66, .14));
  transition: transform .3s var(--ease);
  display: block;
  background-repeat: no-repeat;
  background-position: center bottom;
  background-size: contain;
  flex: 0 0 auto;
}
#purelane-range-{{ section.id }} .rangerow .pimg:nth-child(even) {
  height: 118px;
}
#purelane-range-{{ section.id }} .rangerow img.range-custom-img {
  height: 132px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 9px 14px rgba(0, 74, 66, .14));
  transition: transform .3s var(--ease);
  display: block;
  flex: 0 0 auto;
}
#purelane-range-{{ section.id }} .rangerow img.range-custom-img:nth-child(even) {
  height: 118px;
}
#purelane-range-{{ section.id }} .rangerow > *:hover {
  transform: translateY(-4px) scale(1.03);
}

#purelane-range-{{ section.id }} .p-tap { background-image: var(--p-tap); aspect-ratio: 0.6387; }
#purelane-range-{{ section.id }} .p-kitchen { background-image: var(--p-kitchen); aspect-ratio: 0.6387; }
#purelane-range-{{ section.id }} .p-metal { background-image: var(--p-metal); aspect-ratio: 0.6993; }
#purelane-range-{{ section.id }} .p-wm { background-image: var(--p-wm); aspect-ratio: 0.6148; }
#purelane-range-{{ section.id }} .p-dish { background-image: var(--p-dish); aspect-ratio: 0.624; }
#purelane-range-{{ section.id }} .p-floor { background-image: var(--p-floor); aspect-ratio: 0.6312; }
#purelane-range-{{ section.id }} .p-toilet { background-image: var(--p-toilet); aspect-ratio: 0.6139; }
#purelane-range-{{ section.id }} .p-laundry { background-image: var(--p-laundry); aspect-ratio: 0.6302; }
#purelane-range-{{ section.id }} .p-handwash { background-image: var(--p-handwash); aspect-ratio: 0.7453; }
#purelane-range-{{ section.id }} .p-eraser { background-image: var(--p-eraser); aspect-ratio: 1.3187; }

/* Swipe hint */
#purelane-range-{{ section.id }} .striphint {
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--paper-3);
  margin-top: 6px;
  text-align: left;
}

@media(max-width: 760px) {
  #purelane-range-{{ section.id }} .glass {
    padding: 20px 16px;
  }
  #purelane-range-{{ section.id }} .stripwrap {
    margin: 8px -12px 0;
    padding: 0 12px 6px;
  }
  #purelane-range-{{ section.id }} .rangerow {
    min-height: 132px;
    justify-content: flex-start;
    gap: 12px;
  }
  #purelane-range-{{ section.id }} .rangerow .pimg,
  #purelane-range-{{ section.id }} .rangerow img.range-custom-img {
    height: 116px;
  }
  #purelane-range-{{ section.id }} .rangerow .pimg:nth-child(even),
  #purelane-range-{{ section.id }} .rangerow img.range-custom-img:nth-child(even) {
    height: 104px;
  }
  #purelane-range-{{ section.id }} .range-head {
    gap: 10px;
  }
}
</style>

<section class="sec" id="purelane-range-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass range">
      <div class="range-head">
        <div>
          {%- if section.settings.kicker != blank -%}
            <span class="kicker">{{ section.settings.kicker }}</span>
          {%- endif -%}
          {%- if section.settings.title != blank -%}
            <h2 class="d2" style="margin-top:10px">{{ section.settings.title }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.description != blank -%}
          <p class="body-s">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>

      <div class="stripwrap">
        <div class="rangerow">
          {%- for block in section.blocks -%}
            {%- assign item_product = block.settings.product -%}
            {%- assign item_label = block.settings.label | default: item_product.title | default: "Purelane bottle" -%}
            
            {%- if block.settings.custom_image != blank -%}
              <img 
                src="{{ block.settings.custom_image | image_url: width: 300 }}" 
                alt="{{ item_label | escape }}" 
                class="range-custom-img" 
                loading="lazy" 
                width="120" 
                height="140" 
                {{ block.shopify_attributes }}
              >
            {%- elsif item_product != blank and item_product.featured_image != blank -%}
              <img 
                src="{{ item_product.featured_image | image_url: width: 300 }}" 
                alt="{{ item_label | escape }}" 
                class="range-custom-img" 
                loading="lazy" 
                width="120" 
                height="140" 
                {{ block.shopify_attributes }}
              >
            {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span 
                class="pimg {{ block.settings.icon }}" 
                role="img" 
                aria-label="{{ item_label | escape }}" 
                {{ block.shopify_attributes }}
              ></span>
            {%- else -%}
              <span 
                class="pimg p-floor" 
                role="img" 
                aria-label="{{ item_label | escape }}" 
                {{ block.shopify_attributes }}
              ></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.hint != blank -%}
        <p class="striphint">{{ section.settings.hint }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Full Range Shelf",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow Text",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description Text",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Bottom Hint Text",
      "default": "Swipe to see the full shelf"
    }
  ],
  "blocks": [
    {
      "type": "bottle",
      "name": "Range Item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Shopify Product (optional)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (optional override)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Illustration Icon",
          "default": "p-floor",
          "options": [
            { "value": "p-floor", "label": "Floor Cleaner" },
            { "value": "p-tap", "label": "Tap Cleaner" },
            { "value": "p-kitchen", "label": "Kitchen Cleaner" },
            { "value": "p-toilet", "label": "Toilet Cleaner" },
            { "value": "p-laundry", "label": "Laundry Detergent" },
            { "value": "p-dish", "label": "Dishwash Gel" },
            { "value": "p-metal", "label": "Metal Cleaner" },
            { "value": "p-wm", "label": "Washing Machine Tabs" },
            { "value": "p-handwash", "label": "Handwash" },
            { "value": "p-eraser", "label": "Magic Eraser" }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label / Alt Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Full Range Shelf",
      "blocks": [
        { "type": "bottle", "settings": { "icon": "p-floor", "label": "Floor cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-tap", "label": "Tap cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-kitchen", "label": "Kitchen cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-toilet", "label": "Toilet cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-laundry", "label": "Laundry detergent" } },
        { "type": "bottle", "settings": { "icon": "p-dish", "label": "Dishwash gel" } },
        { "type": "bottle", "settings": { "icon": "p-metal", "label": "Metal cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-wm", "label": "Washing machine cleaner" } },
        { "type": "bottle", "settings": { "icon": "p-handwash", "label": "Handwash" } },
        { "type": "bottle", "settings": { "icon": "p-eraser", "label": "Magic eraser" } }
      ]
    }
  ]
}
{% endschema %}
