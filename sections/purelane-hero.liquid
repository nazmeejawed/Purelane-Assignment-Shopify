{%- comment -%}
  Purelane Pixel-Perfect Hero Section
  Scoped to prevent theme CSS conflicts.
{%- endcomment -%}

{%- style -%}
  /* --- 1. SCOPED VARIABLES & BASE RULES --- */
  #PurelaneHero-{{ section.id }} {
    --ink: #17102b;
    --brand: #4b3a8f;
    --paper-2: rgba(236,230,247,.74);
    --paper-3: rgba(236,230,247,.52);
    --accent: #f0a03c;
    --accent-2: #c9761d;
    --surface: #faf7fd;
    --g-bg: linear-gradient(158deg, rgba(236,230,247,.15), rgba(75,58,143,.20) 58%, rgba(23,16,43,.28));
    --g-line: rgba(236,230,247,.22);
    --g-shadow: 0 26px 74px rgba(18,12,34,.44);
    --g-inset: inset 0 1px 0 rgba(255,255,255,.24);
    --r: 26px;
    --maxw: 1180px;
    --sec-y: 34px;
    --ease: cubic-bezier(.2,.7,.2,1);

    /* Base wrapper styling to replace global body */
    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: var(--ink);
    color: var(--surface);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
  }

  #PurelaneHero-{{ section.id }} * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* --- 2. TYPOGRAPHY (Forced override) --- */
  #PurelaneHero-{{ section.id }} .d1 {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .87;
    color: var(--surface);
    font-size: clamp(48px, 8.6vw, 112px);
    margin-bottom: 20px;
    text-shadow: 0 6px 40px rgba(2,20,19,.55);
  }
  #PurelaneHero-{{ section.id }} .lime { color: var(--accent); }
  #PurelaneHero-{{ section.id }} .lede {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: var(--paper-2);
    max-width: 44ch;
    margin-bottom: 20px;
  }

  /* --- 3. BACKGROUND SCENES & WATER --- */
  #PurelaneHero-{{ section.id }} .scenes {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    overflow: hidden; background: var(--brand);
  }
  #PurelaneHero-{{ section.id }} .scene {
    position: absolute; inset: 0; opacity: 0; transition: opacity 1.5s ease;
  }
  #PurelaneHero-{{ section.id }} .scene.on { opacity: 1; }
  #PurelaneHero-{{ section.id }} .s1 {
    background: linear-gradient(178deg, #1ea38d 0%, #0b8578 22%, #017069 48%, #4b3a8f 74%, #01524e 100%);
  }

  #PurelaneHero-{{ section.id }} .water {
    position: absolute; inset: -14% -10%; pointer-events: none;
  }
  #PurelaneHero-{{ section.id }} .wl {
    position: absolute; inset: 0; will-change: transform;
    transform: translate(var(--px,0), var(--py,0));
  }
  #PurelaneHero-{{ section.id }} .wl-a { mix-blend-mode: screen; opacity: .8; animation: drift-a 34s linear infinite; }
  #PurelaneHero-{{ section.id }} .wl-b { mix-blend-mode: screen; opacity: .54; animation: drift-b 23s linear infinite; }
  #PurelaneHero-{{ section.id }} .vig {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(126% 86% at 50% 28%, transparent 38%, rgba(1,50,46,.20) 78%, rgba(1,34,32,.44) 100%),
                linear-gradient(180deg, rgba(1,38,36,.30) 0%, transparent 18%, transparent 66%, rgba(1,32,30,.40) 100%);
  }

  @keyframes drift-a { 0% { transform: translate3d(-3%,0,0) scale(1.06); } 50% { transform: translate3d(3%,-1.6%,0) scale(1.13); } 100% { transform: translate3d(-3%,0,0) scale(1.06); } }
  @keyframes drift-b { 0% { transform: translate3d(4%,1%,0) scale(1.1); } 50% { transform: translate3d(-4%,-1%,0) scale(1.04); } 100% { transform: translate3d(4%,1%,0) scale(1.1); } }

  /* --- 4. FOREGROUND UI --- */
  #PurelaneHero-{{ section.id }} .hero-content-layer {
    position: relative; z-index: 2; min-height: 100svh;
    display: flex; align-items: flex-end; padding: 150px 0 var(--sec-y);
  }
  #PurelaneHero-{{ section.id }} .hero-content-layer::before {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(102deg, rgba(1,45,42,.68) 0%, rgba(1,45,42,.40) 30%, rgba(1,45,42,.10) 52%, transparent 66%);
  }
  #PurelaneHero-{{ section.id }} .hero-grid {
    max-width: var(--maxw); margin: 0 auto; padding: 0 18px; width: 100%; position: relative; z-index: 2;
  }
  #PurelaneHero-{{ section.id }} .hero-copy { max-width: 600px; position: relative; z-index: 3; }

  /* Buttons */
  #PurelaneHero-{{ section.id }} .btn {
    display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 22px;
    border-radius: 999px; font-size: 12.5px; font-weight: 700; letter-spacing: .13em;
    text-transform: uppercase; transition: .35s var(--ease); text-decoration: none; border: none; cursor: pointer;
  }
  #PurelaneHero-{{ section.id }} .btn-primary {
    background: linear-gradient(135deg, var(--accent-2), #5d8d1c); color: #08211a;
    box-shadow: 0 12px 30px rgba(201,118,29,.34), inset 0 1px 0 rgba(255,255,255,.34);
  }
  #PurelaneHero-{{ section.id }} .btn-ghost {
    background: rgba(236,230,247,.10); border: 1px solid rgba(236,230,247,.30);
    backdrop-filter: blur(12px); color: var(--surface);
  }
  #PurelaneHero-{{ section.id }} .hero-cta { display: flex; gap: 11px; flex-wrap: wrap; margin-top: 26px; }

  /* UI Elements */
  #PurelaneHero-{{ section.id }} .rule { display: flex; align-items: center; gap: 13px; margin: 0 0 20px; max-width: 270px; }
  #PurelaneHero-{{ section.id }} .rule i { height: 1px; flex: 1; background: linear-gradient(90deg, rgba(236,230,247,.44), transparent); }
  #PurelaneHero-{{ section.id }} .rule svg { width: 16px; height: 16px; color: var(--accent); flex: 0 0 auto; }

  #PurelaneHero-{{ section.id }} .glass-2 {
    background: linear-gradient(158deg, rgba(236,230,247,.10), rgba(0,48,46,.22));
    backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(236,230,247,.16);
    border-radius: var(--r);
    box-shadow: 0 18px 48px rgba(18,12,34,.36), inset 0 1px 0 rgba(255,255,255,.16);
  }

  /* Badges */
  #PurelaneHero-{{ section.id }} .badges {
    position: absolute; right: 18px; top: 50%; transform: translateY(-50%);
    width: 96px; z-index: 4; display: flex; flex-direction: column; gap: 2px; padding: 12px 8px; border-radius: 20px;
  }
  #PurelaneHero-{{ section.id }} .badge { text-align: center; padding: 11px 4px; }
  #PurelaneHero-{{ section.id }} .badge + .badge { border-top: 1px solid rgba(236,230,247,.14); }
  #PurelaneHero-{{ section.id }} .badge .bi {
    width: 38px; height: 38px; margin: 0 auto 8px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(236,230,247,.10); border: 1px solid rgba(236,230,247,.22); color: var(--accent);
  }
  #PurelaneHero-{{ section.id }} .badge .bi svg { width: 19px; height: 19px; }
  #PurelaneHero-{{ section.id }} .badge span {
    display: block; font-size: 8.5px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; color: var(--paper-2);
  }
  #PurelaneHero-{{ section.id }} .badgestrip { display: none; }

  /* --- 5. PRODUCTS & STAGE --- */
  #PurelaneHero-{{ section.id }} .hero-prod {
    position: absolute; right: 2%; bottom: 28px; width: min(50vw, 560px); z-index: 2;
    filter: drop-shadow(0 34px 54px rgba(2,20,19,.6));
  }
  #PurelaneHero-{{ section.id }} .hstage { position: relative; width: 100%; height: clamp(380px, 74svh, 680px); }
  #PurelaneHero-{{ section.id }} .hslide {
    position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-end;
    padding-right: 2%; opacity: 0; pointer-events: none; transition: opacity .85s var(--ease);
  }
  #PurelaneHero-{{ section.id }} .hslide.on { opacity: 1; pointer-events: auto; }
  #PurelaneHero-{{ section.id }} .hp {
    position: relative; width: auto; flex: 0 0 auto;
    background-repeat: no-repeat; background-position: center bottom; background-size: contain;
    opacity: 0; transform: translateY(28px) scale(.94); transition: opacity .8s var(--ease), transform .8s var(--ease);
  }
  #PurelaneHero-{{ section.id }} .hslide.on .hp { opacity: 1; transform: none; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d1 { transition-delay: .06s; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d2 { transition-delay: .30s; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d3 { transition-delay: .54s; }

  /* Pricing Tag */
  #PurelaneHero-{{ section.id }} .ptag {
    position: absolute; left: 0; bottom: 2%; z-index: 6; padding: 11px 14px 12px; border-radius: 16px;
    max-width: 52%; opacity: 0; transform: translateY(16px); transition: opacity .8s var(--ease) .62s, transform .8s var(--ease) .62s;
  }
  #PurelaneHero-{{ section.id }} .hslide.on .ptag { opacity: 1; transform: none; }
  #PurelaneHero-{{ section.id }} .ptag .lbl { display: block; font-size: 9px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; color: var(--accent); }
  #PurelaneHero-{{ section.id }} .ptag .val { display: flex; align-items: baseline; gap: 7px; margin-top: 5px; }
  #PurelaneHero-{{ section.id }} .ptag .val strong { font-family: 'Outfit', sans-serif; font-size: 23px; font-weight: 800; color: var(--surface); }
  #PurelaneHero-{{ section.id }} .ptag .val s { font-size: 12px; color: var(--paper-3); }
  #PurelaneHero-{{ section.id }} .ptag .cut { display: inline-block; margin-top: 7px; font-size: 8.4px; font-weight: 800; padding: 3px 8px; border-radius: 999px; background: rgba(240,160,60,.20); color: var(--accent); }

  #PurelaneHero-{{ section.id }} .hdots { display: flex; gap: 7px; justify-content: center; align-items: center; margin-top: 8px; }
  #PurelaneHero-{{ section.id }} .hdots button { width: 6px; height: 6px; padding: 0; border: none; border-radius: 50%; background: rgba(236,230,247,.28); transition: .4s var(--ease); cursor: pointer; }
  #PurelaneHero-{{ section.id }} .hdots button.on { background: var(--accent); width: 20px; border-radius: 999px; }

  /* Specific Slide Positioning */
  #PurelaneHero-{{ section.id }} .hs1 .a { height: 100%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs2 .a { height: 80%; margin-right: -8%; z-index: 1; }
  #PurelaneHero-{{ section.id }} .hs2 .b { height: 97%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs3 .a { height: 75%; margin-right: -8%; z-index: 1; order: 1; }
  #PurelaneHero-{{ section.id }} .hs3 .c { height: 97%; z-index: 3; order: 2; }
  #PurelaneHero-{{ section.id }} .hs3 .b { height: 79%; margin-left: -8%; z-index: 2; order: 3; }

  /* Base64 Images */
  #PurelaneHero-{{ section.id }} .p-kbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.3229; }
  #PurelaneHero-{{ section.id }} .p-tbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.322; }
  #PurelaneHero-{{ section.id }} .p-mbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.3416; }

  /* Mobile Tweaks */
  @media(max-width:900px){
    #PurelaneHero-{{ section.id }} .hero-content-layer { align-items: flex-end; padding-top: 132px; }
    #PurelaneHero-{{ section.id }} .badges { display: none; }
    #PurelaneHero-{{ section.id }} .badgestrip { display: flex; gap: 8px; margin-top: 24px; }
    #PurelaneHero-{{ section.id }} .badgestrip div { flex: 1; text-align: center; padding: 11px 6px; border-radius: 14px; font-size: 8.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-2); line-height: 1.3; }
    #PurelaneHero-{{ section.id }} .badgestrip svg { width: 18px; height: 18px; margin: 0 auto 6px; color: var(--accent); }
    #PurelaneHero-{{ section.id }} .hero-prod { position: relative; right: auto; bottom: auto; width: min(88vw, 420px); margin: 20px auto 0; }
  }
  @media(max-width:760px){
    #PurelaneHero-{{ section.id }} .d1 { font-size: clamp(44px, 13.5vw, 64px); }
  }
{%- endstyle -%}

<div id="PurelaneHero-{{ section.id }}">
  <!-- Background Layer -->
  <div class="scenes">
    <div class="scene s1 on"></div>
  </div>
  <div class="water" id="Water-{{ section.id }}">
    <div class="wl wl-a">
      <svg class="sv" viewBox="0 0 1800 1100" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="cg" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#eafff4" stop-opacity="0"/><stop offset=".18" stop-color="#f2fff8" stop-opacity=".95"/><stop offset=".5" stop-color="#ffffff" stop-opacity="1"/><stop offset=".82" stop-color="#e6fbef" stop-opacity=".9"/><stop offset="1" stop-color="#eafff4" stop-opacity="0"/></linearGradient>
          <filter id="wf" x="-12%" y="-12%" width="124%" height="124%"><feTurbulence type="fractalNoise" baseFrequency="0.0022 0.019" numOctaves="3" seed="21" result="n"/><feDisplacementMap in="SourceGraphic" in2="n" scale="72" xChannelSelector="R" yChannelSelector="G"/></filter>
        </defs>
        <g filter="url(#wf)">
          <path d="M262 230 Q372 261 482 238 Q592 247 702 250 Q812 210 923 235" stroke="url(#cg)" stroke-width="1.7" fill="none" opacity="0.45" stroke-linecap="round"/>
          <path d="M137 256 Q307 242 477 258 Q646 238 816 245 Q985 259 1155 247" stroke="url(#cg)" stroke-width="5.1" fill="none" opacity="0.23" stroke-linecap="round"/>
          <path d="M389 715 Q514 756 639 725 Q763 738 888 742 Q1013 688 1138 721" stroke="url(#cg)" stroke-width="5.7" fill="none" opacity="0.37" stroke-linecap="round"/>
        </g>
      </svg>
    </div>
  </div>
  <div class="vig"></div>

  <!-- Content Layer -->
  <div class="hero-content-layer">
    <div class="hero-grid">
      <!-- Desktop Badges -->
      <div class="badges glass-2" aria-label="Product promises">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="badge" {{ block.shopify_attributes }}>
              <span class="bi">
                {%- if block.settings.icon == 'plant' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>
                {%- elsif block.settings.icon == 'shield' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
                {%- endif -%}
              </span>
              <span>{{ block.settings.text | newline_to_br }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Main Copy -->
      <div class="hero-copy">
        {%- assign heading_parts = section.settings.heading | split: section.settings.highlighted_word -%}
        <h1 class="d1">
          {{ heading_parts[0] | newline_to_br }}
          {% if section.settings.highlighted_word != blank -%}
            <span class="lime">{{ section.settings.highlighted_word }}</span>
          {%- endif %}
          {{ heading_parts[1] | newline_to_br }}
        </h1>

        <div class="rule">
          <i></i>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>

        <p class="lede">{{ section.settings.paragraph | escape }}</p>

        <div class="hero-cta">
          <a class="btn btn-primary" href="{{ section.settings.primary_cta_link | default: '#' }}">
            {{ section.settings.primary_cta_label | escape }}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
          {%- if section.settings.secondary_cta_label != blank -%}
            <a class="btn btn-ghost" href="{{ section.settings.secondary_cta_link | default: '#' }}">
              {{- section.settings.secondary_cta_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <!-- Mobile Badges -->
        <div class="badgestrip">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="glass-2">
                {%- if block.settings.icon == 'plant' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>
                {%- elsif block.settings.icon == 'shield' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
                {%- endif -%}
                {{ block.settings.text | replace: '\n', ' ' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Product Carousel -->
      <div class="hero-prod">
        <div class="hstage" id="HStage-{{ section.id }}">
          {%- assign slide_blocks = section.blocks | where: 'type', 'stage_slide' -%}
          {%- if slide_blocks.size > 0 -%}
            {%- for block in slide_blocks -%}
              {%- assign slide_index = forloop.index -%}
              <div
                class="hslide hs{{ slide_index }} {% if slide_index == 1 %}on{% endif %}"
                data-n="{{ slide_index }}"
                {{ block.shopify_attributes }}
              >
                {%- if slide_index == 1 -%}
                  <span class="hp p-kbtl a d1" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- elsif slide_index == 2 -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane Tap Cleaner"></span>
                  <span class="hp p-kbtl b d2" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- else -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane Tap Cleaner"></span>
                  <span class="hp p-mbtl b d2" role="img" aria-label="Purelane Brass Cleaner"></span>
                  <span class="hp p-kbtl c d3" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- endif -%}

                <div class="glass-2 ptag">
                  <span class="lbl">{{ block.settings.title }}</span>
                  <span class="val"
                    ><strong>{{ block.settings.price }}</strong><s>{{ block.settings.compare_price }}</s></span
                  >
                  <span class="cut">{{ block.settings.discount_badge }}</span>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="hdots" id="HDots-{{ section.id }}">
          {%- if slide_blocks.size > 0 -%}
            {%- for block in slide_blocks -%}
              <button
                type="button"
                class="{% if forloop.index == 1 %}on{% endif %}"
                aria-label="Show {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    /* Scoped Carousel Logic for this Specific Section */
    const sectionId = '{{ section.id }}';
    const stage = document.getElementById('HStage-' + sectionId);
    const dotsContainer = document.getElementById('HDots-' + sectionId);

    if (stage && dotsContainer) {
      const slides = Array.from(stage.querySelectorAll('.hslide'));
      const dots = Array.from(dotsContainer.querySelectorAll('button'));
      let timer;

      function setSlide(n) {
        slides.forEach((s, i) => s.classList.toggle('on', i === n));
        dots.forEach((d, i) => d.classList.toggle('on', i === n));
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          clearInterval(timer);
          setSlide(i);
        });
      });

      if (slides.length > 1) {
        let idx = 0;
        timer = setInterval(() => {
          idx = (idx + 1) % slides.length;
          setSlide(idx);
        }, 4500);
      }
    }

    /* Scoped Parallax logic (Only for this hero) */
    const heroWrapper = document.getElementById('PurelaneHero-' + sectionId);
    const waterLayer = heroWrapper.querySelector('.wl-a');
    if (window.matchMedia('(min-width: 1024px)').matches && waterLayer) {
      window.addEventListener(
        'mousemove',
        (e) => {
          const mx = (e.clientX / window.innerWidth - 0.5) * 2;
          const my = (e.clientY / window.innerHeight - 0.5) * 2;
          waterLayer.style.setProperty('--px', (mx * 6).toFixed(1) + 'px');
          waterLayer.style.setProperty('--py', (my * 6).toFixed(1) + 'px');
        },
        { passive: true }
      );
    }
  });
</script>

