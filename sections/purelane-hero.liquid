{%- comment -%}
  Purelane Pixel-Perfect Hero Section - EXACT PROTOTYPE MATCH (Version 2 Colors & Full SVGs)
{%- endcomment -%}
<style>
  body, .gradient, #MainContent, .shopify-section { background: transparent !important; }

  /* --- 1. SCOPED VARIABLES & BASE RULES (VERSION 2 LIGHT THEME) --- */
  #PurelaneHero-{{ section.id }} {
    --ink: #f4f0fb;
    --deep: #e2daf3;
    --brand: #4b3a8f;
    --brand-lt: #6b55b8;
    --paper: #241a3d;
    --paper-2: rgba(36,26,61,.78);
    --paper-3: rgba(36,26,61,.56);
    --accent: #b8701c;
    --accent-2: #c9761d;
    --surface: #17102b;
    --g-bg: linear-gradient(158deg, rgba(255,255,255,.80), rgba(236,230,247,.56) 58%, rgba(222,212,240,.50));
    --g-line: rgba(75,58,143,.16);
    --g-shadow: 0 22px 54px rgba(58,44,112,.13);
    --g-inset: inset 0 1px 0 rgba(255,255,255,.92);
    --r: 26px;
    --maxw: 1180px;
    --sec-y: 34px;
    --ease: cubic-bezier(.2,.7,.2,1);

    position: relative;
    width: 100%;
    min-height: 100svh;
    overflow: hidden;
    background: transparent;
    color: var(--surface);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    line-height: 1.62;
    -webkit-font-smoothing: antialiased;
    padding-bottom: 74px;
  }

  @media(min-width:960px){ #PurelaneHero-{{ section.id }} { padding-bottom:0; } }

  #PurelaneHero-{{ section.id }} * { box-sizing: border-box; margin: 0; padding: 0; }
  #PurelaneHero-{{ section.id }} a { text-decoration: none; color: inherit; }
  #PurelaneHero-{{ section.id }} button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
  #PurelaneHero-{{ section.id }} img, #PurelaneHero-{{ section.id }} svg { display: block; max-width: 100%; }

  /* --- 2. TYPOGRAPHY --- */
  #PurelaneHero-{{ section.id }} .d1 {
    font-family: 'Outfit', system-ui, sans-serif;
    text-transform: uppercase;
    letter-spacing: -.018em;
    font-weight: 800;
    line-height: .87;
    color: var(--surface);
    font-size: clamp(48px, 8.6vw, 112px);
    margin-bottom: 20px;
    text-shadow: none; /* V2 override */
  }
  #PurelaneHero-{{ section.id }} .lime { color: var(--accent); }
  #PurelaneHero-{{ section.id }} .lede {
    font-size: clamp(15px, 1.35vw, 17.5px);
    color: var(--paper-2);
    max-width: 44ch;
    margin-bottom: 20px;
  }

  /* --- 3. BACKGROUND SCENES & WATER (VERSION 2 LIGHT THEME) --- */
  .scenes {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
    overflow: hidden; 
    /* Force mint-green gradient by default to prevent lavender flash/bleed */
    background: linear-gradient(178deg, #fbfffb 0%, #eafaec 24%, #d6f1dc 54%, #bfe8ca 100%);
  }
  .scene {
    position: absolute; inset: 0; opacity: 0; transition: opacity 1.5s ease;
  }
  .scene.on { opacity: 1; }
  .s1 {
    background: linear-gradient(178deg, #fbfffb 0%, #eafaec 24%, #d6f1dc 54%, #bfe8ca 100%);
  }

  .water {
    position: absolute; inset: -14% -10%; pointer-events: none; transition: opacity 1.2s ease; opacity: 1;
  }
  .wl {
    position: absolute; inset: 0; will-change: transform;
    transform: translate(var(--px,0), var(--py,0));
  }
  .wl .sv { width: 100%; height: 100%; }

  /* V2 Blend Modes & Opacities */
  .wl-a { mix-blend-mode: soft-light; opacity: 1; animation: drift-a 34s linear infinite; }
  .wl-a .sv { filter: contrast(1.25); }
  .wl-b { mix-blend-mode: overlay; opacity: .66; animation: drift-b 23s linear infinite; }
  .wl-c { mix-blend-mode: overlay; opacity: .6; animation: shaft-sway 19s ease-in-out infinite; }
  .wl-s { mix-blend-mode: overlay; opacity: .72; animation: surface 11s ease-in-out infinite; transform-origin: 50% 0; }

  @keyframes drift-a { 0% { transform: translate3d(-3%,0,0) scale(1.06); } 50% { transform: translate3d(3%,-1.6%,0) scale(1.13); } 100% { transform: translate3d(-3%,0,0) scale(1.06); } }
  @keyframes drift-b { 0% { transform: translate3d(4%,1%,0) scale(1.1); } 50% { transform: translate3d(-4%,-1%,0) scale(1.04); } 100% { transform: translate3d(4%,1%,0) scale(1.1); } }
  @keyframes shaft-sway { 0% { transform: translate3d(-2%,0,0) skewX(0deg); opacity: .34; } 50% { transform: translate3d(2%,0,0) skewX(2.4deg); opacity: .6; } 100% { transform: translate3d(-2%,0,0) skewX(0deg); opacity: .34; } }
  @keyframes surface { 0% { transform: translateY(0) scaleY(1); opacity: .55; } 50% { transform: translateY(-1.4%) scaleY(1.14); opacity: .82; } 100% { transform: translateY(0) scaleY(1); opacity: .55; } }

  /* Bubbles */
  .bub { position: absolute; inset: 0; overflow: hidden; }
  .bub span {
    position: absolute; bottom: -6%; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%;
    border: 1px solid rgba(75,58,143,.26);
    background: radial-gradient(circle at 34% 30%, rgba(255,255,255,.9), rgba(255,255,255,0) 64%);
    animation: rise var(--dur) linear infinite; animation-delay: var(--dly); opacity: 0;
  }
  @keyframes rise { 0% { transform: translate3d(0,0,0); opacity: 0; } 12% { opacity: .7; } 88% { opacity: .5; } 100% { transform: translate3d(var(--drift), -116vh, 0); opacity: 0; } }

  /* V2 Vignette */
  #PurelaneHero-{{ section.id }} .vig {
    position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(126% 88% at 50% 26%, transparent 42%, rgba(75,58,143,.07) 80%, rgba(0,80,74,.16) 100%),
                linear-gradient(180deg, rgba(255,255,255,.40) 0%, transparent 20%, transparent 70%, rgba(0,84,78,.10) 100%);
  }

  /* --- 4. FOREGROUND UI --- */
  #PurelaneHero-{{ section.id }} .hero-content-layer {
    position: relative; z-index: 2; min-height: 100svh;
    display: flex; align-items: center; padding: 110px 0 50px;
  }
  #PurelaneHero-{{ section.id }} .hero-content-layer::before {
    content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(102deg, rgba(255,255,255,.80) 0%, rgba(255,255,255,.50) 30%, rgba(255,255,255,.12) 54%, transparent 68%);
  }
  @media(max-width:900px) {
    #PurelaneHero-{{ section.id }} .hero-content-layer {
      align-items: flex-end; padding-top: 110px;
    }
    #PurelaneHero-{{ section.id }} .hero-content-layer::before {
      background: linear-gradient(180deg, rgba(255,255,255,.62) 0%, rgba(255,255,255,.34) 36%, rgba(255,255,255,.66) 100%);
    }
  }

  #PurelaneHero-{{ section.id }} .hero-grid {
    max-width: var(--maxw); margin: 0 auto; padding: 0 18px; width: 100%; position: relative; z-index: 2;
  }
  #PurelaneHero-{{ section.id }} .hero-copy { max-width: 600px; position: relative; z-index: 3; }

  /* V2 Glass & Shadows */
  #PurelaneHero-{{ section.id }} .glass-2 {
    background: linear-gradient(158deg, rgba(255,255,255,.66), rgba(236,230,247,.44));
    backdrop-filter: blur(18px) saturate(135%);
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    border: 1px solid rgba(75,58,143,.13);
    border-radius: var(--r);
    box-shadow: 0 16px 38px rgba(58,44,112,.10), inset 0 1px 0 rgba(255,255,255,.86);
    position: relative; overflow: hidden;
  }

  /* V2 Buttons */
  #PurelaneHero-{{ section.id }} .hero-cta { display: flex; gap: 11px; flex-wrap: wrap; margin-top: 26px; }
  #PurelaneHero-{{ section.id }} .btn {
    display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 22px;
    border-radius: 999px; font-size: 12.5px; font-weight: 700; letter-spacing: .13em;
    text-transform: uppercase; transition: transform .35s var(--ease), box-shadow .35s var(--ease), background .35s var(--ease) !important; white-space: nowrap;
    text-decoration: none !important;
  }

  #PurelaneHero-{{ section.id }} .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 32px rgba(0,80,74,.32), inset 0 1px 0 rgba(255,255,255,.3) !important;
    filter: brightness(1.05);
  }
  #PurelaneHero-{{ section.id }} .btn-ghost:hover {
    background: rgba(36,26,61,.08) !important;
    transform: translateY(-2px);
  }
  #PurelaneHero-{{ section.id }} .btn svg { width: 15px; height: 15px; flex: 0 0 auto; }
  #PurelaneHero-{{ section.id }} .btn-primary {
    background: linear-gradient(135deg, #00706a, #004b46); color: #f4fdf6;
    box-shadow: 0 12px 26px rgba(0,80,74,.26), inset 0 1px 0 rgba(255,255,255,.22);
  }
  #PurelaneHero-{{ section.id }} .btn-primary:hover {
    box-shadow: 0 18px 36px rgba(0,80,74,.32), inset 0 1px 0 rgba(255,255,255,.28) !important; transform: translateY(-3px) !important;
  }
  #PurelaneHero-{{ section.id }} .btn-ghost {
    background: rgba(255,255,255,.66); border: 1px solid rgba(75,58,143,.22); color: #01423b;
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  }
  #PurelaneHero-{{ section.id }} .btn-ghost:hover {
    background: rgba(255,255,255,.9) !important; transform: translateY(-3px) !important;
  }

  /* Rule Element */
  #PurelaneHero-{{ section.id }} .rule { display: flex; align-items: center; gap: 13px; margin: 0 0 20px; max-width: 270px; }
  #PurelaneHero-{{ section.id }} .rule i { height: 1px; flex: 1; background: linear-gradient(90deg, rgba(75,58,143,.34), transparent); }
  #PurelaneHero-{{ section.id }} .rule svg { width: 16px; height: 16px; color: var(--accent); flex: 0 0 auto; }

  /* Badges */
  #PurelaneHero-{{ section.id }} .badges {
    position: absolute; right: 18px; top: 42%; transform: translateY(-50%);
    width: 96px; z-index: 4; display: flex; flex-direction: column; gap: 2px; padding: 12px 8px; border-radius: 20px;
  }
  #PurelaneHero-{{ section.id }} .badge { text-align: center; padding: 11px 4px; }
  #PurelaneHero-{{ section.id }} .badge + .badge { border-top: 1px solid rgba(75,58,143,.12); }
  #PurelaneHero-{{ section.id }} .badge .bi {
    width: 38px; height: 38px; margin: 0 auto 8px; border-radius: 50%; display: grid; place-items: center;
    background: rgba(255,255,255,.62); border: 1px solid rgba(75,58,143,.16); color: #4f7d10;
  }
  #PurelaneHero-{{ section.id }} .badge .bi svg { width: 19px; height: 19px; }
  #PurelaneHero-{{ section.id }} .badge span {
    display: block; font-size: 8.5px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; color: var(--paper-2); line-height: 1.34;
  }

  /* --- 5. PRODUCTS & STAGE --- */
  #PurelaneHero-{{ section.id }} .hero-prod {
    position: absolute; right: 2%; bottom: 28px; width: min(50vw, 560px); z-index: 2;
  }
  #PurelaneHero-{{ section.id }} .hero-prod .pimg, #PurelaneHero-{{ section.id }} .hp {
    filter: drop-shadow(0 14px 22px rgba(0,74,66,.15)); /* V2 Light shadow */
  }
  #PurelaneHero-{{ section.id }} .hstage { position: relative; width: 100%; height: clamp(380px, 74svh, 680px); }
  #PurelaneHero-{{ section.id }} .hslide {
    position: absolute; inset: 0; display: flex; align-items: flex-end; justify-content: flex-end;
    padding-right: 2%; opacity: 0; pointer-events: none; transition: opacity .85s var(--ease);
  }
  #PurelaneHero-{{ section.id }} .hslide.on { opacity: 1; pointer-events: auto; }
  #PurelaneHero-{{ section.id }} .hp {
    position: relative; width: auto; flex: 0 0 auto;
    background-repeat: no-repeat; background-position: center bottom; background-size: contain;
    opacity: 0; transform: translateY(28px) scale(.94); transition: opacity .8s var(--ease), transform .8s var(--ease);
  }
  #PurelaneHero-{{ section.id }} .hslide.on .hp { opacity: 1; transform: none; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d1 { transition-delay: .06s; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d2 { transition-delay: .30s; }
  #PurelaneHero-{{ section.id }} .hslide.on .hp.d3 { transition-delay: .54s; }

    #PurelaneHero-{{ section.id }} .hs1 .a { height: 100%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs2 .a { height: 80%; margin-right: -8%; z-index: 1; }
  #PurelaneHero-{{ section.id }} .hs2 .b { height: 97%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs3 .a { height: 75%; margin-right: -8%; z-index: 1; order: 1; }
  #PurelaneHero-{{ section.id }} .hs3 .c { height: 97%; z-index: 3; order: 2; }
  #PurelaneHero-{{ section.id }} .hs3 .b { height: 79%; margin-left: -8%; z-index: 2; order: 3; }


  /* Pricing Tag V2 Override */
  #PurelaneHero-{{ section.id }} .ptag {
    position: absolute; left: 0; bottom: 2%; z-index: 6; padding: 11px 14px 12px; border-radius: 16px;
    max-width: 52%; opacity: 0; transform: translateY(16px); transition: opacity .8s var(--ease) .62s, transform .8s var(--ease) .62s;
  }
  #PurelaneHero-{{ section.id }} .hslide.on .ptag { opacity: 1; transform: none; }
  #PurelaneHero-{{ section.id }} .ptag .lbl { display: block; font-size: 9px; font-weight: 800; letter-spacing: .17em; text-transform: uppercase; color: var(--accent); }
  #PurelaneHero-{{ section.id }} .ptag .val { display: flex; align-items: baseline; gap: 7px; margin-top: 5px; }
  #PurelaneHero-{{ section.id }} .ptag .val strong { font-family: 'Outfit', sans-serif; font-size: 23px; font-weight: 800; letter-spacing: -.02em; color: var(--surface); line-height: 1; }
  #PurelaneHero-{{ section.id }} .ptag .val s { font-size: 12px; color: var(--paper-3); }
  #PurelaneHero-{{ section.id }} .ptag .cut {
    display: inline-block; margin-top: 7px; font-size: 8.4px; font-weight: 800; letter-spacing: .11em; text-transform: uppercase;
    padding: 3px 8px; border-radius: 999px; background: rgba(201,118,29,.16); border: 1px solid rgba(201,118,29,.36); color: #4f7d10;
  }

  /* Stage Controls */
  #PurelaneHero-{{ section.id }} .hdots { display: flex; gap: 7px; justify-content: center; align-items: center; margin-top: 8px; }
  #PurelaneHero-{{ section.id }} .hdots button { width: 6px; height: 6px; padding: 0; border-radius: 50%; background: rgba(75,58,143,.22); transition: .4s var(--ease); border: none; }
  #PurelaneHero-{{ section.id }} .hdots button.on { background: #b8701c; width: 20px; border-radius: 999px; }
  #PurelaneHero-{{ section.id }} .hdots button:hover { background: rgba(75,58,143,.4); }

  /* Slide specific positioning */
  #PurelaneHero-{{ section.id }} .hs1 .a { height: 100%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs2 .a { height: 80%; margin-right: -8%; z-index: 1; }
  #PurelaneHero-{{ section.id }} .hs2 .b { height: 97%; z-index: 3; }
  #PurelaneHero-{{ section.id }} .hs3 .a { height: 75%; margin-right: -8%; z-index: 1; order: 1; }
  #PurelaneHero-{{ section.id }} .hs3 .c { height: 97%; z-index: 3; order: 2; }
  #PurelaneHero-{{ section.id }} .hs3 .b { height: 79%; margin-left: -8%; z-index: 2; order: 3; }

  /* Base64 Images */
  #PurelaneHero-{{ section.id }} .p-kbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.3229; }
  #PurelaneHero-{{ section.id }} .p-tbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.322; }
  #PurelaneHero-{{ section.id }} .p-mbtl { background-image: url("data:image/svg+xml;base64,"); aspect-ratio: 0.3416; }

  /* Mobile Adjustments */
  #PurelaneHero-{{ section.id }} .badgestrip { display: none; }
  @media(max-width:900px){
    #PurelaneHero-{{ section.id }} .hero-content-layer { align-items: flex-end; padding-top: 132px; }
    #PurelaneHero-{{ section.id }} .badges { display: none; }
    #PurelaneHero-{{ section.id }} .badgestrip { display: flex; gap: 8px; margin-top: 24px; }
    #PurelaneHero-{{ section.id }} .badgestrip div { flex: 1; text-align: center; padding: 11px 6px; border-radius: 14px; font-size: 8.5px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--paper-2); line-height: 1.3; }
    #PurelaneHero-{{ section.id }} .badgestrip svg { width: 18px; height: 18px; margin: 0 auto 6px; color: var(--accent); }
    #PurelaneHero-{{ section.id }} .hero-prod { position: relative; right: auto; bottom: auto; width: min(88vw, 420px); margin: 20px auto 0; }
  }
  @media(max-width:760px){
    #PurelaneHero-{{ section.id }} .d1 { font-size: clamp(44px, 13.5vw, 64px); }
  }
</style>

<div id="PurelaneHero-{{ section.id }}">
  <!-- --- CONTENT LAYER --- -->
  <div class="hero-content-layer">
    <div class="hero-grid">
      <!-- Desktop Badges -->
      <div class="badges glass-2 rv" aria-label="Product promises">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_badge' -%}
            <div class="badge" {{ block.shopify_attributes }}>
              <span class="bi">
                {%- if block.settings.icon == 'plant' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>
                {%- elsif block.settings.icon == 'shield' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
                {%- endif -%}
              </span>
              <span>{{ block.settings.text | newline_to_br }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <!-- Main Copy -->
      <div class="hero-copy">
        {%- assign heading_parts = section.settings.heading | split: section.settings.highlighted_word -%}
        <h1 class="d1 rv in">
          {{ heading_parts[0] | newline_to_br }}
          {% if section.settings.highlighted_word != blank -%}
            <span class="lime">{{ section.settings.highlighted_word }}</span>
          {%- endif %}
          {{ heading_parts[1] | newline_to_br }}
        </h1>

        <div class="rule rv rv-d1">
          <i></i>
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
          </svg>
          <i></i>
        </div>

        <p class="lede rv rv-d2">{{ section.settings.paragraph | escape }}</p>

        <div class="hero-cta rv rv-d3">
          <a class="btn btn-primary" href="#shop" onclick="event.preventDefault();document.getElementById('shop')&&document.getElementById('shop').scrollIntoView({behavior:'smooth',block:'start'})">
            {{ section.settings.primary_cta_label | escape }}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h13m-5-6 6 6-6 6"/>
            </svg>
          </a>
          {%- if section.settings.secondary_cta_label != blank -%}
            <a class="btn btn-ghost" href="#proof" onclick="event.preventDefault();document.getElementById('proof')&&document.getElementById('proof').scrollIntoView({behavior:'smooth',block:'start'})">
              {{- section.settings.secondary_cta_label | escape -}}
            </a>
          {%- endif -%}
        </div>

        <!-- Mobile Badges -->
        <div class="badgestrip rv rv-d4">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust_badge' -%}
              <div class="glass-2">
                {%- if block.settings.icon == 'plant' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
                  </svg>
                {%- elsif block.settings.icon == 'shield' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/>
                  </svg>
                {%- elsif block.settings.icon == 'check' -%}
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/>
                  </svg>
                {%- endif -%}
                {{ block.settings.text | replace: '\n', ' ' }}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>

      <!-- Product Carousel -->
      <div class="hero-prod">
        <div class="hstage" id="HStage-{{ section.id }}">
          {%- assign slide_blocks = section.blocks | where: 'type', 'stage_slide' -%}
          {%- if slide_blocks.size > 0 -%}
            {%- for block in slide_blocks -%}
              {%- assign slide_index = forloop.index -%}
              <div
                class="hslide hs{{ slide_index }} {% if slide_index == 1 %}on{% endif %}"
                data-n="{{ slide_index }}"
                {{ block.shopify_attributes }}
              >
                {%- if slide_index == 1 -%}
                  <span class="hp p-kbtl a d1" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- elsif slide_index == 2 -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane Tap Cleaner"></span>
                  <span class="hp p-kbtl b d2" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- else -%}
                  <span class="hp p-tbtl a d1" role="img" aria-label="Purelane Tap Cleaner"></span>
                  <span class="hp p-mbtl b d2" role="img" aria-label="Purelane Brass Cleaner"></span>
                  <span class="hp p-kbtl c d3" role="img" aria-label="Purelane Kitchen Cleaner"></span>
                {%- endif -%}

                <div class="glass-2 ptag">
                  <span class="lbl">{{ block.settings.title }}</span>
                  <span class="val"
                    ><strong>{{ block.settings.price }}</strong><s>{{ block.settings.compare_price }}</s></span
                  >
                  <span class="cut">{{ block.settings.discount_badge }}</span>
                </div>
              </div>
            {%- endfor -%}
          {%- endif -%}
        </div>

        <div class="hdots" id="HDots-{{ section.id }}">
          {%- if slide_blocks.size > 0 -%}
            {%- for block in slide_blocks -%}
              <button
                type="button"
                class="{% if forloop.index == 1 %}on{% endif %}"
                aria-label="Show {{ forloop.index }}"
              ></button>
            {%- endfor -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function() {
    /* Scoped Carousel Logic */
    const sectionId = '{{ section.id }}';
    const stage = document.getElementById('HStage-' + sectionId);
    const dotsContainer = document.getElementById('HDots-' + sectionId);

    if (stage && dotsContainer) {
      const slides = Array.from(stage.querySelectorAll('.hslide'));
      const dots = Array.from(dotsContainer.querySelectorAll('button'));
      let timer;
      let currentIndex = 0;

      function setSlide(n) {
        currentIndex = n;
        slides.forEach((s, i) => s.classList.toggle('on', i === n));
        dots.forEach((d, i) => d.classList.toggle('on', i === n));
      }

      function play() {
        if (!timer && !reduce && slides.length > 1) {
          timer = setInterval(() => {
            setSlide((currentIndex + 1) % slides.length);
          }, 4500);
        }
      }
      function stop() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      dots.forEach((dot, i) => {
        dot.addEventListener('click', () => {
          stop();
          setSlide(i);
          play();
        });
      });
      
      stage.addEventListener('mouseenter', stop);
      stage.addEventListener('mouseleave', play);
      
      /* Initialize carousel */
      play();
    }

    /* Ambient Bottle Pulse */
    if (!reduce && stage) {
      const hps = stage.querySelectorAll('.hp');
      hps.forEach(prod => {
        prod.animate(
          [{ filter: 'drop-shadow(0 14px 22px rgba(0,74,66,.15))' },
           { filter: 'drop-shadow(0 22px 36px rgba(0,74,66,.25))' },
           { filter: 'drop-shadow(0 14px 22px rgba(0,74,66,.15))' }],
          { duration: 7000, iterations: Infinity, easing: 'ease-in-out' }
        );
      });
    }

    /* Scoped Parallax logic */
    const heroWrapper = document.getElementById('PurelaneHero-' + sectionId);
    const waterLayer = heroWrapper.querySelector('.wl-a');
    if (window.matchMedia('(min-width: 1024px)').matches && waterLayer && !reduce) {
      window.addEventListener(
        'mousemove',
        (e) => {
          const mx = (e.clientX / window.innerWidth - 0.5) * 2;
          const my = (e.clientY / window.innerHeight - 0.5) * 2;
          waterLayer.style.setProperty('--px', (mx * 6).toFixed(1) + 'px');
          waterLayer.style.setProperty('--py', (my * 6).toFixed(1) + 'px');
        },
        { passive: true }
      );
    }


    /* Mouse Hover Parallax for Hero Products (Bottles) */
    if (window.matchMedia('(min-width: 1024px)').matches && stage && !reduce) {
      window.addEventListener('mousemove', function(e) {
        const mx = (e.clientX / window.innerWidth - 0.5) * 2;
        const my = (e.clientY / window.innerHeight - 0.5) * 2;
        
        // Move the entire stage slightly
        stage.style.transform = `translate3d(${ (mx * -16).toFixed(2) }px, ${ (my * -10).toFixed(2) }px, 0)`;
      }, { passive: true });
      
      // Reset when mouse leaves
      window.addEventListener('mouseleave', function() {
        stage.style.transform = `translate3d(0, 0, 0)`;
      });
    }

    /* Fix SVG filters and gradients in Shopify Theme Editor (<base> tag issues) */
    if (document.querySelector('base')) {
      const baseUrl = window.location.href.split('#')[0];
      const svgs = document.querySelectorAll('#PurelaneHero-{{ section.id }} svg');
      svgs.forEach(svg => {
        const elementsWithUrl = svg.querySelectorAll('[fill^="url("], [stroke^="url("], [filter^="url("]');
        elementsWithUrl.forEach(el => {
          ['fill', 'stroke', 'filter'].forEach(attr => {
            const val = el.getAttribute(attr);
            if (val && val.startsWith('url(#')) {
              el.setAttribute(attr, val.replace('url(#', 'url(' + baseUrl + '#'));
            }
          });
        });
      });
    }
  })();
</script>

