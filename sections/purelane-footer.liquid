      "label": "Show Sticky Bottom CTA Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_heading",
      "label": "Sticky Bar Heading",
      "default": "Pick any 3, pay ₹499"
    },
    {
      "type": "text",
      "id": "sticky_subtext",
      "label": "Sticky Bar Subtext",
      "default": "Free shipping, always"
    },
    {
      "type": "text",
      "id": "sticky_button_label",
      "label": "Sticky Button Label",
      "default": "Build bundle"
    },
    {
      "type": "url",
      "id": "sticky_button_link",
      "label": "Sticky Button Link"
    }
  ],
  "presets": [
    {
      "name": "Purelane Footer"
    }
  ]
}
{% endschema %}
