    {
      "type": "header",
      "content": "Column 2 (About)"
    },
    {
      "type": "text",
      "id": "col2_heading",
      "label": "Column 2 Heading",
      "default": "About"
    },
    {
      "type": "link_list",
      "id": "col2_menu",
      "label": "Column 2 Menu (optional)"
    },
    {
      "type": "header",
      "content": "Column 3 (Contact)"
    },
    {
      "type": "text",
      "id": "col3_heading",
      "label": "Column 3 Heading",
      "default": "Get in touch"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "hello@purelane.com"
    },
    {
      "type": "text",
