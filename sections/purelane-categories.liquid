<style>
#purelane-categories-{{ section.id }} {
  /* VERSION 2 — LIGHT MODE (from prototype) */
  --ink:#f4f0fb;
  --deep:#e2daf3;
  --brand:#4b3a8f;
  --brand-lt:#6b55b8;
  --paper:#241a3d;
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;
  --accent-2:#c9761d;
  --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --r-sm:16px;
  --maxw:1180px;
  --ease:cubic-bezier(.2,.7,.2,1);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  color:var(--paper);
  line-height:1.62;
  -webkit-font-smoothing:antialiased;
  padding:0 0 clamp(40px,6vw,80px);

  /* Product SVGs */
  --p-kitchen:url("data:image/svg+xml;base64,");
  --p-toilet:url("data:image/svg+xml;base64,");
  --p-laundry:url("data:image/svg+xml;base64,");
  --p-tap:url("data:image/svg+xml;base64,");
}

#purelane-categories-{{ section.id }} a { text-decoration: none; color: inherit; }
#purelane-categories-{{ section.id }} p, #purelane-categories-{{ section.id }} h2, #purelane-categories-{{ section.id }} h4 { margin: 0; }
#purelane-categories-{{ section.id }} .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 18px; }

/* Header */
#purelane-categories-{{ section.id }} .panel-head {
  text-align: center;
  margin-bottom: 32px;
}
#purelane-categories-{{ section.id }} .kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .22em;
  text-transform: uppercase;
  color: var(--paper-3);
}
#purelane-categories-{{ section.id }} .d2 {
  font-family: 'Outfit', system-ui, sans-serif;
  text-transform: uppercase;
  letter-spacing: -.018em;
  font-weight: 800;
  line-height: .94;
  color: var(--surface);
  font-size: clamp(28px, 4.2vw, 50px);
  margin-top: 12px;
}

/* Categories Grid */
#purelane-categories-{{ section.id }} .cats {
  display: grid;
  gap: 14px;
  grid-template-columns: repeat(2, 1fr);
}
@media(min-width: 900px) {
  #purelane-categories-{{ section.id }} .cats {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Glass Card */
#purelane-categories-{{ section.id }} .glass {
  background: var(--g-bg);
  backdrop-filter: blur(24px) saturate(150%);
  -webkit-backdrop-filter: blur(24px) saturate(150%);
  border: 1px solid var(--g-line);
  border-radius: var(--r);
  box-shadow: var(--g-shadow), var(--g-inset);
  position: relative;
  overflow: hidden;
}
#purelane-categories-{{ section.id }} .glass::after {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  border-radius: inherit;
  background: linear-gradient(115deg, rgba(255, 255, 255, .55), transparent 32%, transparent 74%, rgba(201, 118, 29, .06));
}

#purelane-categories-{{ section.id }} .cat {
  padding: 0;
  display: flex;
  flex-direction: column;
  transition: .4s var(--ease);
}
#purelane-categories-{{ section.id }} .cat:hover {
  transform: translateY(-5px);
}

/* Product placeholder illustration area */
#purelane-categories-{{ section.id }} .cat .ph {
  height: 194px;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 14px 12px 0;
  position: relative;
  overflow: hidden;
}
#purelane-categories-{{ section.id }} .cat .ph::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(110% 80% at 50% 6%, rgba(255, 255, 255, .66), rgba(236, 230, 247, .30) 58%, transparent 80%);
}
#purelane-categories-{{ section.id }} .cat .ph .pimg {
  position: relative;
  height: 176px;
  filter: drop-shadow(0 10px 15px rgba(0, 74, 66, .14));
  transition: transform .35s var(--ease);
  display: block;
  background-repeat: no-repeat;
  background-position: center bottom;
  background-size: contain;
}
#purelane-categories-{{ section.id }} .cat .ph img.cat-custom-img {
  position: relative;
  height: 176px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 10px 15px rgba(0, 74, 66, .14));
  transition: transform .35s var(--ease);
  display: block;
}
#purelane-categories-{{ section.id }} .cat:hover .ph .pimg,
#purelane-categories-{{ section.id }} .cat:hover .ph img.cat-custom-img {
  transform: scale(1.04);
}

#purelane-categories-{{ section.id }} .p-kitchen { background-image: var(--p-kitchen); aspect-ratio: 0.6387; }
#purelane-categories-{{ section.id }} .p-toilet { background-image: var(--p-toilet); aspect-ratio: 0.6139; }
#purelane-categories-{{ section.id }} .p-laundry { background-image: var(--p-laundry); aspect-ratio: 0.6302; }
#purelane-categories-{{ section.id }} .p-tap { background-image: var(--p-tap); aspect-ratio: 0.6387; }

/* Text details */
#purelane-categories-{{ section.id }} .cat .txt {
  padding: 14px 16px 18px;
  border-top: 1px solid rgba(75, 58, 143, .11);
  background: rgba(255, 255, 255, .25);
  position: relative;
  z-index: 2;
}
#purelane-categories-{{ section.id }} .cat .txt h4 {
  font-family: 'Outfit', sans-serif;
  font-size: 14px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: .03em;
  color: var(--surface);
  margin-bottom: 5px;
}
#purelane-categories-{{ section.id }} .cat .txt p {
  font-size: 11.8px;
  color: var(--paper-3);
}

@media(max-width: 760px) {
  #purelane-categories-{{ section.id }} .cat .ph {
    height: 158px;
  }
  #purelane-categories-{{ section.id }} .cat .ph .pimg,
  #purelane-categories-{{ section.id }} .cat .ph img.cat-custom-img {
    height: 142px;
  }
  #purelane-categories-{{ section.id }} .cat .txt {
    padding: 12px 14px 14px;
  }
  #purelane-categories-{{ section.id }} .cat .txt h4 {
    font-size: 13px;
  }
}
</style>

<section class="sec" id="purelane-categories-{{ section.id }}" data-scene="4">
  <div class="wrap">
    <div class="panel-head">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker }}</span>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="d2">{{ section.settings.title }}</h2>
      {%- endif -%}
    </div>

    <div class="cats">
      {%- for block in section.blocks -%}
        <a class="glass cat" href="{{ block.settings.link | default: '#combos' }}" {{ block.shopify_attributes }}>
          <span class="ph">
            {%- if block.settings.custom_image != blank -%}
              <img 
                src="{{ block.settings.custom_image | image_url: width: 400 }}" 
                alt="{{ block.settings.title | escape }}" 
                class="cat-custom-img" 
                loading="lazy" 
                width="160" 
                height="180"
              >
            {%- elsif block.settings.icon != blank and block.settings.icon != 'none' -%}
              <span class="pimg {{ block.settings.icon }}" role="img" aria-label="{{ block.settings.title | escape }}"></span>
            {%- else -%}
              <span class="pimg p-kitchen" role="img" aria-label="{{ block.settings.title | escape }}"></span>
            {%- endif -%}
          </span>
          <span class="txt">
            <h4>{{ block.settings.title }}</h4>
            <p>{{ block.settings.subtitle }}</p>
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Categories",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow Text",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (optional override)"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Illustration Icon",
          "default": "p-kitchen",
          "options": [
            { "value": "p-kitchen", "label": "Kitchen Cleaner" },
            { "value": "p-toilet", "label": "Toilet Cleaner" },
            { "value": "p-laundry", "label": "Laundry Detergent" },
            { "value": "p-tap", "label": "Tap Cleaner" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Kitchen bundle",
            "subtitle": "Grease, dishes & more",
            "icon": "p-kitchen"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Bathroom bundle",
            "subtitle": "Deep clean & disinfect",
            "icon": "p-toilet"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Laundry bundle",
            "subtitle": "Softer, fresher wash",
            "icon": "p-laundry"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Hard water bundle",
            "subtitle": "Melt away limescale",
            "icon": "p-tap"
          }
        }
      ]
    }
  ]
}
{% endschema %}
