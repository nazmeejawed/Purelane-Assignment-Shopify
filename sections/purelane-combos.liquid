<style>
#purelane-combos-{{ section.id }} {

  /* VERSION 2 — LIGHT MODE (from prototype) */
  --ink:#f4f0fb;
  --deep:#e2daf3;
  --brand:#4b3a8f;
  --brand-lt:#6b55b8;
  --paper:#241a3d;
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;
  --accent-2:#c9761d;
  --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --r-sm:16px;
  --maxw:1180px;
  --sec-y:34px;
  --ease:cubic-bezier(.2,.7,.2,1);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  color:var(--paper);
  line-height:1.62;
  -webkit-font-smoothing:antialiased;


--p-combo2:url("data:image/svg+xml;base64,");
--p-dish:url("data:image/svg+xml;base64,");
--p-eraser:url("data:image/svg+xml;base64,");
--p-floor:url("data:image/svg+xml;base64,");
--p-handwash:url("data:image/svg+xml;base64,");
--p-kbtl:url("data:image/svg+xml;base64,");
--p-kitchen:url("data:image/svg+xml;base64,");
--p-laundry:url("data:image/svg+xml;base64,");
--p-mbtl:url("data:image/svg+xml;base64,");
--p-metal:url("data:image/svg+xml;base64,");
--p-tap:url("data:image/svg+xml;base64,");
--p-tbtl:url("data:image/svg+xml;base64,");
--p-toilet:url("data:image/svg+xml;base64,");
--p-wm:url("data:image/svg+xml;base64,");


  padding: clamp(40px, 6vw, 80px) 0;
}

#purelane-combos-{{ section.id }} a { text-decoration: none; }
#purelane-combos-{{ section.id }} p, #purelane-combos-{{ section.id }} h2, #purelane-combos-{{ section.id }} h3 { margin: 0; }
#purelane-combos-{{ section.id }} .panel-head { text-align: center; margin-bottom: 32px; }
#purelane-combos-{{ section.id }} .panel-head .rule { margin: 18px auto 0; justify-content: center; }
#purelane-combos-{{ section.id }} .panel-head .lede { margin-left: auto; margin-right: auto; }

/* TYPOGRAPHY */
#purelane-combos-{{ section.id }} .d1,#purelane-combos-{{ section.id }} .d2,#purelane-combos-{{ section.id }} .d3,#purelane-combos-{{ section.id }} .d4{font-family:'Outfit',system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.018em;font-weight:800;line-height:.87;color:var(--surface)}
#purelane-combos-{{ section.id }} .d1{font-size:clamp(48px,8.6vw,112px)}
#purelane-combos-{{ section.id }} .d2{font-size:clamp(30px,4.6vw,54px);line-height:.94}
#purelane-combos-{{ section.id }} .d3{font-size:clamp(21px,2.5vw,30px);line-height:1.04;font-weight:700;letter-spacing:-.01em}
#purelane-combos-{{ section.id }} .d4{font-size:clamp(16px,1.6vw,19px);line-height:1.14;font-weight:700;letter-spacing:.005em}
#purelane-combos-{{ section.id }} .lede{font-size:clamp(15px,1.35vw,17.5px);color:var(--paper-2);max-width:44ch}
#purelane-combos-{{ section.id }} .body-s{font-size:14.5px;color:var(--paper-2);line-height:1.66}
#purelane-combos-{{ section.id }} .kicker{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--paper-3)}
#purelane-combos-{{ section.id }} .wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}
/* GLASS */
#purelane-combos-{{ section.id }} .glass{
  background:var(--g-bg);
  backdrop-filter:blur(24px) saturate(150%);
  -webkit-backdrop-filter:blur(24px) saturate(150%);
  border:1px solid var(--g-line);
  border-radius:var(--r);
  box-shadow:var(--g-shadow),var(--g-inset);
  position:relative;
  overflow:hidden;
}
#purelane-combos-{{ section.id }} .glass::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(115deg,rgba(255,255,255,.16),transparent 30%,transparent 72%,rgba(240,160,60,.07))}
#purelane-combos-{{ section.id }} .glass-2{
  background:linear-gradient(158deg,rgba(236,230,247,.10),rgba(0,48,46,.22));
  backdrop-filter:blur(18px) saturate(135%);
  -webkit-backdrop-filter:blur(18px) saturate(135%);
  border:1px solid rgba(236,230,247,.16);
  border-radius:var(--r);
  box-shadow:0 18px 48px rgba(18,12,34,.36),inset 0 1px 0 rgba(255,255,255,.16);
  position:relative;overflow:hidden;
}
#purelane-combos-{{ section.id }} .glass::after{background:linear-gradient(115deg,rgba(255,255,255,.55),transparent 32%,transparent 74%,rgba(201,118,29,.06))}
#purelane-combos-{{ section.id }} .glass-2{
  background:linear-gradient(158deg,rgba(255,255,255,.66),rgba(236,230,247,.44));
  border:1px solid rgba(75,58,143,.13);
  box-shadow:0 16px 38px rgba(58,44,112,.10),inset 0 1px 0 rgba(255,255,255,.86)}
/* BUTTONS */
#purelane-combos-{{ section.id }} .btn{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 22px;border-radius:999px;
  font-size:12.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;transition:.35s var(--ease);white-space:nowrap}
#purelane-combos-{{ section.id }} .btn svg{width:15px;height:15px;flex:0 0 auto}
#purelane-combos-{{ section.id }} .btn-primary{background:linear-gradient(135deg,var(--accent-2),#5d8d1c);color:#08211a;box-shadow:0 12px 30px rgba(201,118,29,.34),inset 0 1px 0 rgba(255,255,255,.34)}
#purelane-combos-{{ section.id }} .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 40px rgba(201,118,29,.44),inset 0 1px 0 rgba(255,255,255,.4)}
#purelane-combos-{{ section.id }} .btn-ghost{background:rgba(236,230,247,.10);border:1px solid rgba(236,230,247,.30);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);color:var(--surface)}
#purelane-combos-{{ section.id }} .btn-ghost:hover{background:rgba(236,230,247,.18);transform:translateY(-2px)}
#purelane-combos-{{ section.id }} .btn-sm{height:38px;padding:0 18px;font-size:11px;letter-spacing:.14em}
#purelane-combos-{{ section.id }} .btn-primary{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6;
  box-shadow:0 12px 26px rgba(0,80,74,.26),inset 0 1px 0 rgba(255,255,255,.22)}
#purelane-combos-{{ section.id }} .btn-primary:hover{box-shadow:0 18px 36px rgba(0,80,74,.32),inset 0 1px 0 rgba(255,255,255,.28)}
#purelane-combos-{{ section.id }} .btn-ghost{background:rgba(255,255,255,.66);border:1px solid rgba(75,58,143,.22);color:#01423b}
#purelane-combos-{{ section.id }} .btn-ghost:hover{background:rgba(255,255,255,.9)}
/* COMBOS */
#purelane-combos-{{ section.id }} .rule{display:flex;align-items:center;gap:13px;margin:0 0 20px;max-width:270px}
#purelane-combos-{{ section.id }} .rule i{height:1px;flex:1;background:linear-gradient(90deg,rgba(236,230,247,.44),transparent)}
#purelane-combos-{{ section.id }} .rule svg{width:16px;height:16px;color:var(--accent);flex:0 0 auto}
#purelane-combos-{{ section.id }} .panel-head .rule i:first-child{background:linear-gradient(90deg,transparent,rgba(236,230,247,.44))}
#purelane-combos-{{ section.id }} .comborail{display:flex;gap:14px;overflow-x:auto;overflow-y:hidden;scroll-snap-type:x mandatory;
  margin:0 -18px;padding:4px 18px 14px;scrollbar-width:none;-webkit-overflow-scrolling:touch}
#purelane-combos-{{ section.id }} .comborail::-webkit-scrollbar{display:none}
#purelane-combos-{{ section.id }} .combo{flex:0 0 302px;scroll-snap-align:start;display:flex;flex-direction:column;padding:0;transition:.4s var(--ease)}
#purelane-combos-{{ section.id }} .combo:hover{transform:translateY(-5px)}
#purelane-combos-{{ section.id }} .combo.hero-combo{border-color:rgba(240,160,60,.42);box-shadow:0 26px 74px rgba(18,12,34,.44),0 0 0 1px rgba(240,160,60,.2),var(--g-inset)}
#purelane-combos-{{ section.id }} .combo .tray{padding:14px 14px 13px;border-bottom:1px solid rgba(236,230,247,.13);position:relative;
  background:linear-gradient(162deg,rgba(236,230,247,.13),rgba(75,58,143,.10))}
#purelane-combos-{{ section.id }} .combo .save{display:inline-block;font-size:9.5px;font-weight:800;letter-spacing:.12em;text-transform:uppercase;
  padding:5px 11px;border-radius:999px;background:rgba(3,30,28,.72);border:1px solid rgba(240,160,60,.34);color:var(--accent);margin-bottom:13px}
#purelane-combos-{{ section.id }} .combo .flag{position:absolute;top:14px;right:14px;font-size:8.6px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  padding:5px 10px;border-radius:999px;background:linear-gradient(135deg,var(--accent-2),#5d8d1c);color:#08211a}
#purelane-combos-{{ section.id }} .stack{display:flex;align-items:flex-end;gap:3px}
#purelane-combos-{{ section.id }} .stack .it{flex:1 1 0;min-width:0;text-align:center}
#purelane-combos-{{ section.id }} .stack .it .pimg{height:66px;margin:0 auto 8px;filter:drop-shadow(0 8px 13px rgba(1,24,22,.5))}
#purelane-combos-{{ section.id }} .stack .it .tile{height:66px;width:44px;margin:0 auto 8px;display:grid;place-items:center;border-radius:9px;
  background:rgba(236,230,247,.08);border:1px dashed rgba(236,230,247,.26);color:var(--accent)}
#purelane-combos-{{ section.id }} .stack .it .tile svg{width:17px;height:17px}
#purelane-combos-{{ section.id }} .stack .it span{display:block;font-size:8.6px;line-height:1.32;color:var(--paper-2);font-weight:600}
#purelane-combos-{{ section.id }} .stack .plus{flex:0 0 9px;color:var(--accent);font-weight:800;font-size:12px;padding-bottom:30px;text-align:center}
#purelane-combos-{{ section.id }} .combo .body{padding:15px 16px 18px;display:flex;flex-direction:column;flex:1}
#purelane-combos-{{ section.id }} .combo .body h3{font-family:'Outfit',sans-serif;font-size:16px;font-weight:700;text-transform:uppercase;
  letter-spacing:-.005em;line-height:1.1;color:var(--surface)}
#purelane-combos-{{ section.id }} .combo .cnt{font-size:10.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--paper-3);margin-top:6px}
#purelane-combos-{{ section.id }} .combo .inc{font-size:12.4px;color:var(--paper-2);line-height:1.55;margin:11px 0 14px;flex:1}
#purelane-combos-{{ section.id }} .combo .prow{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-bottom:6px}
#purelane-combos-{{ section.id }} .combo .prow strong{font-family:'Outfit',sans-serif;font-size:25px;font-weight:800;color:var(--surface);letter-spacing:-.02em}
#purelane-combos-{{ section.id }} .combo .prow s{font-size:13px;color:var(--paper-3)}
#purelane-combos-{{ section.id }} .combo .prow em{font-style:normal;font-size:9.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  padding:4px 9px;border-radius:999px;background:rgba(240,160,60,.18);border:1px solid rgba(240,160,60,.36);color:var(--accent)}
#purelane-combos-{{ section.id }} .combo .fine{font-size:10.4px;color:var(--paper-3);margin-bottom:14px}
#purelane-combos-{{ section.id }} .combo .btn{width:100%;justify-content:center}
#purelane-combos-{{ section.id }} .railnote{text-align:center;font-size:12px;color:var(--paper-3);margin-top:14px;max-width:62ch;margin-left:auto;margin-right:auto}
#purelane-combos-{{ section.id }} .swipecue{display:flex;align-items:center;justify-content:center;gap:8px;font-size:10px;font-weight:700;
  letter-spacing:.16em;text-transform:uppercase;color:var(--paper-3);margin-top:2px}
#purelane-combos-{{ section.id }} .swipecue svg{width:14px;height:14px;color:var(--accent)}
#purelane-combos-{{ section.id }} .rule i{background:linear-gradient(90deg,rgba(75,58,143,.34),transparent)}
#purelane-combos-{{ section.id }} .panel-head .rule i:first-child{background:linear-gradient(90deg,transparent,rgba(75,58,143,.34))}
#purelane-combos-{{ section.id }} .stack .it .pimg{filter:drop-shadow(0 5px 8px rgba(0,74,66,.13))}
#purelane-combos-{{ section.id }} .combo .tray{background:linear-gradient(162deg,rgba(255,255,255,.56),rgba(236,230,247,.34));
  border-bottom:1px solid rgba(75,58,143,.12)}
#purelane-combos-{{ section.id }} .combo .save{background:rgba(255,255,255,.84);border:1px solid rgba(201,118,29,.34);color:#4f7d10}
#purelane-combos-{{ section.id }} .combo .flag{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6}
#purelane-combos-{{ section.id }} .stack .it .tile{background:rgba(255,255,255,.5);border:1px dashed rgba(75,58,143,.26);color:#4f7d10}
/* PIMG */
#purelane-combos-{{ section.id }} .pimg{display:block;background-repeat:no-repeat;background-position:center bottom;background-size:contain;flex:0 0 auto}
#purelane-combos-{{ section.id }} .p-combo2{background-image:var(--p-combo2);aspect-ratio:1.1247}
#purelane-combos-{{ section.id }} .p-dish{background-image:var(--p-dish);aspect-ratio:0.624}
#purelane-combos-{{ section.id }} .p-eraser{background-image:var(--p-eraser);aspect-ratio:1.3187}
#purelane-combos-{{ section.id }} .p-floor{background-image:var(--p-floor);aspect-ratio:0.6312}
#purelane-combos-{{ section.id }} .p-handwash{background-image:var(--p-handwash);aspect-ratio:0.7453}
#purelane-combos-{{ section.id }} .p-kbtl{background-image:var(--p-kbtl);aspect-ratio:0.3229}
#purelane-combos-{{ section.id }} .p-kitchen{background-image:var(--p-kitchen);aspect-ratio:0.6387}
#purelane-combos-{{ section.id }} .p-laundry{background-image:var(--p-laundry);aspect-ratio:0.6302}
#purelane-combos-{{ section.id }} .p-mbtl{background-image:var(--p-mbtl);aspect-ratio:0.3416}
#purelane-combos-{{ section.id }} .p-metal{background-image:var(--p-metal);aspect-ratio:0.6993}
#purelane-combos-{{ section.id }} .p-tap{background-image:var(--p-tap);aspect-ratio:0.6387}
#purelane-combos-{{ section.id }} .p-tbtl{background-image:var(--p-tbtl);aspect-ratio:0.322}
#purelane-combos-{{ section.id }} .p-toilet{background-image:var(--p-toilet);aspect-ratio:0.6139}
#purelane-combos-{{ section.id }} .p-wm{background-image:var(--p-wm);aspect-ratio:0.6148}

/* OVERRIDES */
#purelane-combos-{{ section.id }} .glass::after{background:linear-gradient(115deg,rgba(255,255,255,.55),transparent 32%,transparent 74%,rgba(201,118,29,.06))}
#purelane-combos-{{ section.id }} .glass-2{
  background:linear-gradient(158deg,rgba(255,255,255,.66),rgba(236,230,247,.44));
  border:1px solid rgba(75,58,143,.13);
  box-shadow:0 16px 38px rgba(58,44,112,.10),inset 0 1px 0 rgba(255,255,255,.86)}
#purelane-combos-{{ section.id }} .btn-primary{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6;
  box-shadow:0 12px 26px rgba(0,80,74,.26),inset 0 1px 0 rgba(255,255,255,.22)}
#purelane-combos-{{ section.id }} .btn-primary:hover{box-shadow:0 18px 36px rgba(0,80,74,.32),inset 0 1px 0 rgba(255,255,255,.28)}
#purelane-combos-{{ section.id }} .btn-ghost{background:rgba(255,255,255,.66);border:1px solid rgba(75,58,143,.22);color:#01423b}
#purelane-combos-{{ section.id }} .btn-ghost:hover{background:rgba(255,255,255,.9)}
#purelane-combos-{{ section.id }} .rule i{background:linear-gradient(90deg,rgba(75,58,143,.34),transparent)}
#purelane-combos-{{ section.id }} .panel-head .rule i:first-child{background:linear-gradient(90deg,transparent,rgba(75,58,143,.34))}
#purelane-combos-{{ section.id }} .stack .it .pimg{filter:drop-shadow(0 5px 8px rgba(0,74,66,.13))}
#purelane-combos-{{ section.id }} .combo .tray{background:linear-gradient(162deg,rgba(255,255,255,.56),rgba(236,230,247,.34));
  border-bottom:1px solid rgba(75,58,143,.12)}
#purelane-combos-{{ section.id }} .combo .save{background:rgba(255,255,255,.84);border:1px solid rgba(201,118,29,.34);color:#4f7d10}
#purelane-combos-{{ section.id }} .combo .flag{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6}
#purelane-combos-{{ section.id }} .stack .it .tile{background:rgba(255,255,255,.5);border:1px dashed rgba(75,58,143,.26);color:#4f7d10}
#purelane-combos-{{ section.id }} .tier .tag,#purelane-combos-{{ section.id }} .combo .prow em{background:rgba(201,118,29,.14);border:1px solid rgba(201,118,29,.34);color:#4f7d10}
#purelane-combos-{{ section.id }} .tier.best,#purelane-combos-{{ section.id }} .combo.hero-combo{border-color:rgba(201,118,29,.46);
  box-shadow:0 22px 54px rgba(58,44,112,.14),0 0 0 1px rgba(201,118,29,.24),var(--g-inset)}
#purelane-combos-{{ section.id }} .stack .it .tile{background:rgba(255,255,255,.5);border:1px dashed rgba(75,58,143,.26);color:#4f7d10}

@media(max-width:1200px){
  #purelane-combos-{{ section.id }} .combo{flex:0 0 268px}
}
@media(max-width:900px){
  #purelane-combos-{{ section.id }} .comborail{margin:0 -14px;padding:4px 14px 12px}
  #purelane-combos-{{ section.id }} .stack .it .pimg{height:56px}
  #purelane-combos-{{ section.id }} .stack .it .tile{height:56px;width:38px}
}
</style>
<section class="sec" id="purelane-combos-{{ section.id }}" data-scene="3">

  <div class="wrap">
    <div class="panel-head">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.description }}</p>
    </div>
    
    <div class="comborail">
      {%- for block in section.blocks -%}
      <article class="glass combo {% if block.settings.is_primary %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
        <div class="tray">
          {%- if block.settings.saving_badge != blank -%}
          <span class="save">{{ block.settings.saving_badge }}</span>
          {%- endif -%}
          {%- if block.settings.flag_badge != blank -%}
          <span class="flag">{{ block.settings.flag_badge }}</span>
          {%- endif -%}
          
          <div class="stack">
            {%- assign has_prev = false -%}
            
            {%- if block.settings.p1_class != blank and block.settings.p1_class != 'none' -%}
              <span class="it">
                {%- if block.settings.p1_class == 'p-tile' -%}
                <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                {%- else -%}
                <span class="pimg {{ block.settings.p1_class }}" role="img" aria-label="{{ block.settings.p1_label | escape }}"></span>
                {%- endif -%}
                <span>{{ block.settings.p1_label }}</span>
              </span>
              {%- assign has_prev = true -%}
            {%- endif -%}
            
            {%- if block.settings.p2_class != blank and block.settings.p2_class != 'none' -%}
              {%- if has_prev -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
              <span class="it">
                {%- if block.settings.p2_class == 'p-tile' -%}
                <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                {%- else -%}
                <span class="pimg {{ block.settings.p2_class }}" role="img" aria-label="{{ block.settings.p2_label | escape }}"></span>
                {%- endif -%}
                <span>{{ block.settings.p2_label }}</span>
              </span>
              {%- assign has_prev = true -%}
            {%- endif -%}
            
            {%- if block.settings.p3_class != blank and block.settings.p3_class != 'none' -%}
              {%- if has_prev -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
              <span class="it">
                {%- if block.settings.p3_class == 'p-tile' -%}
                <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                {%- else -%}
                <span class="pimg {{ block.settings.p3_class }}" role="img" aria-label="{{ block.settings.p3_label | escape }}"></span>
                {%- endif -%}
                <span>{{ block.settings.p3_label }}</span>
              </span>
              {%- assign has_prev = true -%}
            {%- endif -%}
            
            {%- if block.settings.p4_class != blank and block.settings.p4_class != 'none' -%}
              {%- if has_prev -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
              <span class="it">
                {%- if block.settings.p4_class == 'p-tile' -%}
                <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                {%- else -%}
                <span class="pimg {{ block.settings.p4_class }}" role="img" aria-label="{{ block.settings.p4_label | escape }}"></span>
                {%- endif -%}
                <span>{{ block.settings.p4_label }}</span>
              </span>
              {%- assign has_prev = true -%}
            {%- endif -%}
            
            {%- if block.settings.p5_class != blank and block.settings.p5_class != 'none' -%}
              {%- if has_prev -%}<span class="plus" aria-hidden="true">+</span>{%- endif -%}
              <span class="it">
                {%- if block.settings.p5_class == 'p-tile' -%}
                <span class="tile"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
                {%- else -%}
                <span class="pimg {{ block.settings.p5_class }}" role="img" aria-label="{{ block.settings.p5_label | escape }}"></span>
                {%- endif -%}
                <span>{{ block.settings.p5_label }}</span>
              </span>
            {%- endif -%}
          </div>
        </div>
        <div class="body">
          <h3>{{ block.settings.title }}</h3>
          <div class="cnt">{{ block.settings.product_count }}</div>
          <p class="inc">{{ block.settings.description }}</p>
          <div class="prow">
            <strong>{{ block.settings.price }}</strong>
            {%- if block.settings.compare_price != blank -%}<s>{{ block.settings.compare_price }}</s>{%- endif -%}
            {%- if block.settings.saving_text != blank -%}<em>{{ block.settings.saving_text }}</em>{%- endif -%}
          </div>
          <div class="fine">Inclusive of all taxes &middot; COD available</div>
          <a class="btn {% if block.settings.is_primary %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#bundles' }}">
            {{ block.settings.button_label }} 
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </div>
      </article>
      {%- endfor -%}
    </div>
    
    <div class="swipecue" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
      {{ section.settings.swipe_text | default: 'Swipe for more combos' }}
    </div>
    <p class="railnote">{{ section.settings.railnote | default: 'Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.' }}</p>
  </div>
</section>

