<div id="PurelaneTicker-{{ section.id }}" class="purelane-ticker" aria-hidden="true">
  <div class="track">
    {%- if section.blocks.size > 0 -%}
      {%- for i in (1..6) -%}
        {%- for block in section.blocks -%}
          <span>{{ block.settings.text }}</span>
        {%- endfor -%}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..3) -%}
        <span>Free shipping <b>on every bundle across India</b></span>
        <span>100% plant-based <b>and non-toxic</b></span>
        <span>Loved by <b>30,000+ happy homes</b></span>
        <span>Buy 3 <b>at flat ₹499</b></span>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

<style>
  #shopify-section-{{ section.id }},
  .section-ticker,
  #PurelaneTicker-{{ section.id }} {
    display: block !important;
    width: 100% !important;
    position: fixed !important;
    top: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: 38px !important;
    min-height: 38px !important;
    max-height: 38px !important;
    z-index: 1000 !important;
    margin: 0 !important;
    padding: 0 !important;
  }
  #PurelaneTicker-{{ section.id }} {
    overflow: hidden;
    white-space: nowrap;
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: .1em;
    text-transform: uppercase;
    background: rgba(255, 255, 255, .78);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(75, 58, 143, .12);
    color: rgba(36, 26, 61, .78);
    display: flex;
    align-items: center;
    box-sizing: border-box;
  }
  #PurelaneTicker-{{ section.id }} .track {
    display: inline-flex;
    align-items: center;
    gap: 40px;
    padding: 9px 20px;
    will-change: transform;
    animation: pl-tick-{{ section.id }} 28s linear infinite;
    flex-shrink: 0;
  }
  #PurelaneTicker-{{ section.id }}:hover .track {
    animation-play-state: paused;
  }
  #PurelaneTicker-{{ section.id }} span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-shrink: 0;
    color: rgba(36, 26, 61, .78);
    font-size: 11.5px;
  }
  #PurelaneTicker-{{ section.id }} b,
  #PurelaneTicker-{{ section.id }} strong {
    color: #4f7d10 !important;
    font-weight: 700 !important;
  }
  @keyframes pl-tick-{{ section.id }} {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(-50%, 0, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    #PurelaneTicker-{{ section.id }} .track { animation: none; }
  }
</style>

{% schema %}
{
  "name": "Purelane Ticker",
  "class": "section-ticker",
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "text",
          "default": "Free shipping <b>on every bundle across India</b>",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Ticker",
      "blocks": [
        { "type": "announcement", "settings": { "text": "Free shipping <b>on every bundle across India</b>" } },
        { "type": "announcement", "settings": { "text": "100% plant-based <b>and non-toxic</b>" } },
        { "type": "announcement", "settings": { "text": "Loved by <b>30,000+ happy homes</b>" } },
        { "type": "announcement", "settings": { "text": "Buy 3 <b>at flat ₹499</b>" } }
      ]
    }
  ]
}
{% endschema %}
