<style>
#purelane-bundles-{{ section.id }} {
  /* VERSION 2 — LIGHT MODE */
  --ink:#f4f0fb;
  --deep:#e2daf3;
  --brand:#4b3a8f;
  --brand-lt:#6b55b8;
  --paper:#241a3d;
  --paper-2:rgba(36,26,61,.78);
  --paper-3:rgba(36,26,61,.56);
  --accent:#b8701c;
  --accent-2:#c9761d;
  --surface:#17102b;
  --g-bg:linear-gradient(158deg,rgba(255,255,255,.80),rgba(236,230,247,.56) 58%,rgba(222,212,240,.50));
  --g-line:rgba(75,58,143,.16);
  --g-shadow:0 22px 54px rgba(58,44,112,.13);
  --g-inset:inset 0 1px 0 rgba(255,255,255,.92);
  --r:26px;
  --r-sm:16px;
  --maxw:1180px;
  --ease:cubic-bezier(.2,.7,.2,1);
  font-family:'Inter',system-ui,-apple-system,sans-serif;
  color:var(--paper);
  line-height:1.62;
  -webkit-font-smoothing:antialiased;
  padding:0 0 clamp(40px,6vw,80px);

  /* product SVGs */
  --p-combo2:url("data:image/svg+xml;base64,");
  --p-kitchen:url("data:image/svg+xml;base64,");
  --p-tap:url("data:image/svg+xml;base64,");
  --p-dish:url("data:image/svg+xml;base64,");
  --p-floor:url("data:image/svg+xml;base64,");
  --p-toilet:url("data:image/svg+xml;base64,");
  --p-laundry:url("data:image/svg+xml;base64,");
}

#purelane-bundles-{{ section.id }} a{text-decoration:none}
#purelane-bundles-{{ section.id }} p,#purelane-bundles-{{ section.id }} h2,#purelane-bundles-{{ section.id }} h3{margin:0}
#purelane-bundles-{{ section.id }} .wrap{max-width:var(--maxw);margin:0 auto;padding:0 18px}

/* typography */
#purelane-bundles-{{ section.id }} .d2{font-family:'Outfit',system-ui,sans-serif;text-transform:uppercase;letter-spacing:-.018em;font-weight:800;line-height:.94;color:var(--surface);font-size:clamp(30px,4.6vw,54px)}
#purelane-bundles-{{ section.id }} .lede{font-size:clamp(15px,1.35vw,17.5px);color:var(--paper-2);max-width:44ch}
#purelane-bundles-{{ section.id }} .kicker{font-size:11px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:var(--paper-3)}
#purelane-bundles-{{ section.id }} .body-s{font-size:14.5px;color:var(--paper-2);line-height:1.66}

/* glass */
#purelane-bundles-{{ section.id }} .glass{
  background:var(--g-bg);
  backdrop-filter:blur(24px) saturate(150%);-webkit-backdrop-filter:blur(24px) saturate(150%);
  border:1px solid var(--g-line);border-radius:var(--r);
  box-shadow:var(--g-shadow),var(--g-inset);position:relative;overflow:hidden;
}
#purelane-bundles-{{ section.id }} .glass::after{content:"";position:absolute;inset:0;pointer-events:none;border-radius:inherit;
  background:linear-gradient(115deg,rgba(255,255,255,.55),transparent 32%,transparent 74%,rgba(201,118,29,.06))}

/* buttons */
#purelane-bundles-{{ section.id }} .btn{display:inline-flex;align-items:center;gap:10px;height:46px;padding:0 22px;border-radius:999px;
  font-size:12.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;transition:.35s var(--ease);white-space:nowrap}
#purelane-bundles-{{ section.id }} .btn svg{width:15px;height:15px;flex:0 0 auto}
#purelane-bundles-{{ section.id }} .btn-primary{background:linear-gradient(135deg,#00706a,#004b46);color:#f4fdf6;
  box-shadow:0 12px 26px rgba(0,80,74,.26),inset 0 1px 0 rgba(255,255,255,.22)}
#purelane-bundles-{{ section.id }} .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(0,80,74,.32),inset 0 1px 0 rgba(255,255,255,.28)}
#purelane-bundles-{{ section.id }} .btn-ghost{background:rgba(255,255,255,.66);border:1px solid rgba(75,58,143,.22);color:#01423b}
#purelane-bundles-{{ section.id }} .btn-ghost:hover{background:rgba(255,255,255,.9);transform:translateY(-2px)}

/* header panel */
#purelane-bundles-{{ section.id }} .sec-pad{padding:clamp(26px,3.4vw,40px)}
#purelane-bundles-{{ section.id }} .panel-head{text-align:center}
#purelane-bundles-{{ section.id }} .panel-head .lede{margin:0 auto}

/* pimg */
#purelane-bundles-{{ section.id }} .pimg{display:block;background-repeat:no-repeat;background-position:center bottom;background-size:contain;flex:0 0 auto}
#purelane-bundles-{{ section.id }} .p-combo2{background-image:var(--p-combo2);aspect-ratio:1.1247}
#purelane-bundles-{{ section.id }} .p-kitchen{background-image:var(--p-kitchen);aspect-ratio:0.6387}
#purelane-bundles-{{ section.id }} .p-tap{background-image:var(--p-tap);aspect-ratio:0.6387}
#purelane-bundles-{{ section.id }} .p-dish{background-image:var(--p-dish);aspect-ratio:0.624}
#purelane-bundles-{{ section.id }} .p-floor{background-image:var(--p-floor);aspect-ratio:0.6312}
#purelane-bundles-{{ section.id }} .p-toilet{background-image:var(--p-toilet);aspect-ratio:0.6139}
#purelane-bundles-{{ section.id }} .p-laundry{background-image:var(--p-laundry);aspect-ratio:0.6302}

/* tiers grid */
#purelane-bundles-{{ section.id }} .tiers{display:grid;gap:14px;grid-template-columns:1fr}
@media(min-width:760px){
  #purelane-bundles-{{ section.id }} .tiers{grid-template-columns:repeat(3,1fr)}
}

/* tier card */
#purelane-bundles-{{ section.id }} .tier{padding:24px 22px;transition:.4s var(--ease)}
#purelane-bundles-{{ section.id }} .tier:hover{transform:translateY(-5px)}
#purelane-bundles-{{ section.id }} .tier.best{border-color:rgba(201,118,29,.46);
  box-shadow:0 22px 54px rgba(58,44,112,.14),0 0 0 1px rgba(201,118,29,.24),var(--g-inset)}

/* tag pill */
#purelane-bundles-{{ section.id }} .tier .tag{display:inline-block;font-size:9.5px;font-weight:800;letter-spacing:.16em;text-transform:uppercase;
  padding:5px 11px;border-radius:999px;margin-bottom:14px;
  background:rgba(201,118,29,.14);border:1px solid rgba(201,118,29,.34);color:#4f7d10}

/* tierpix row */
#purelane-bundles-{{ section.id }} .tierpix{display:flex;align-items:flex-end;justify-content:center;gap:2px;height:78px;margin:-4px 0 16px;
  padding:8px 6px;border-radius:14px;
  background:linear-gradient(162deg,rgba(255,255,255,.54),rgba(236,230,247,.34));
  border:1px solid rgba(75,58,143,.11)}
#purelane-bundles-{{ section.id }} .tierpix .pimg{height:62px;filter:drop-shadow(0 5px 8px rgba(0,74,66,.13))}
#purelane-bundles-{{ section.id }} .tierpix.five .pimg{height:54px}

/* qty */
#purelane-bundles-{{ section.id }} .tier .qty{font-family:'Outfit',sans-serif;font-weight:800;font-size:52px;line-height:.9;color:var(--surface);letter-spacing:-.03em}
#purelane-bundles-{{ section.id }} .tier .qty small{font-size:14px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--paper-3);display:block;margin-top:6px}

/* price */
#purelane-bundles-{{ section.id }} .tier .price{font-family:'Outfit',sans-serif;font-weight:700;font-size:27px;color:var(--accent);margin:16px 0 4px}
#purelane-bundles-{{ section.id }} .tier .price s{font-size:14px;color:var(--paper-3);font-weight:500;margin-left:8px}

/* features list */
#purelane-bundles-{{ section.id }} .tier ul{list-style:none;margin:16px 0 20px;display:grid;gap:8px;padding:0}
#purelane-bundles-{{ section.id }} .tier li{display:flex;gap:9px;font-size:13px;color:var(--paper-2)}
#purelane-bundles-{{ section.id }} .tier li svg{width:14px;height:14px;color:#4f7d10;flex:0 0 auto;margin-top:4px}

/* button full width */
#purelane-bundles-{{ section.id }} .tier .btn{width:100%;justify-content:center}

@media(max-width:759px){
  #purelane-bundles-{{ section.id }} .sec-pad{padding:22px 18px}
  #purelane-bundles-{{ section.id }} .tier .qty{font-size:44px}
  #purelane-bundles-{{ section.id }} .tierpix{height:70px}
  #purelane-bundles-{{ section.id }} .tierpix .pimg{height:54px}
  #purelane-bundles-{{ section.id }} .tierpix.five .pimg{height:46px}
}
</style>

<section class="sec" id="purelane-bundles-{{ section.id }}" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.title }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.description }}</p>
      </div>
    </div>

    <div class="tiers">
      {%- for block in section.blocks -%}
      <article class="glass tier {% if block.settings.is_featured %}best{% endif %}" {{ block.shopify_attributes }}>
        <span class="tag">{{ block.settings.tag_label }}</span>

        <div class="tierpix {% if block.settings.product_count == '5' %}five{% endif %}" aria-hidden="true">
          {%- if block.settings.tp1_class != blank and block.settings.tp1_class != 'none' -%}
            <span class="pimg {{ block.settings.tp1_class }}" role="img" aria-label="{{ block.settings.tp1_label | escape }}"></span>
          {%- endif -%}
          {%- if block.settings.tp2_class != blank and block.settings.tp2_class != 'none' -%}
            <span class="pimg {{ block.settings.tp2_class }}" role="img" aria-label="{{ block.settings.tp2_label | escape }}"></span>
          {%- endif -%}
          {%- if block.settings.tp3_class != blank and block.settings.tp3_class != 'none' -%}
            <span class="pimg {{ block.settings.tp3_class }}" role="img" aria-label="{{ block.settings.tp3_label | escape }}"></span>
          {%- endif -%}
          {%- if block.settings.tp4_class != blank and block.settings.tp4_class != 'none' -%}
            <span class="pimg {{ block.settings.tp4_class }}" role="img" aria-label="{{ block.settings.tp4_label | escape }}"></span>
          {%- endif -%}
          {%- if block.settings.tp5_class != blank and block.settings.tp5_class != 'none' -%}
            <span class="pimg {{ block.settings.tp5_class }}" role="img" aria-label="{{ block.settings.tp5_label | escape }}"></span>
          {%- endif -%}
        </div>

        <div class="qty">{{ block.settings.product_count }}<small>Products</small></div>
        <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_price }}</s></div>
        <p class="body-s" style="font-size:12px">{{ block.settings.per_product_text }}</p>

        <ul>
          {%- if block.settings.feature_1 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_1 }}</li>
          {%- endif -%}
          {%- if block.settings.feature_2 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_2 }}</li>
          {%- endif -%}
          {%- if block.settings.feature_3 != blank -%}
            <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.feature_3 }}</li>
          {%- endif -%}
        </ul>

        <a class="btn {% if block.settings.is_featured %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_link | default: '#' }}">
          {{ block.settings.button_label }}
          {%- if block.settings.is_featured -%}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          {%- endif -%}
        </a>
      </article>
      {%- endfor -%}
    </div>
  </div>
</section>

